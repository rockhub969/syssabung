-- FUNGSI MASTER DUMP ENGINE (PENGAMBIL SEMUA DATA UNTUK SCRIPT DEVELOPMENT)
-- ==============================================================================
local lastGeneratedScriptTemplate = ""

local function generateComprehensiveScriptDump()
    notify("Scanner Game", "Sedang memindai seluruh data, parameter, remote, dan koordinat...")

    local char = localPlayer.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local myPos = hrp and hrp.Position or Vector3.new(0, 0, 0)
    local myCF = hrp and hrp.CFrame or CFrame.new(0, 0, 0)

    -- Nama Game
    local gameName = "Unknown Game"
    pcall(function()
        local info = MarketplaceService:GetProductInfo(game.PlaceId)
        if info and info.Name then gameName = info.Name end
    end)

    local lines = {}
    local function add(str) table.insert(lines, str or "") end

    add("-- ==============================================================================")
    add(string.format("--            SCRIPT BOILERPLATE & DATA DUMP: %s", gameName:upper()))
    add("--          (Generated by SysHub Universal Scanner for Script Developers)         ")
    add("-- ==============================================================================")
    add(string.format("-- PlaceId      : %d", game.PlaceId))
    add(string.format("-- JobId        : %q", tostring(game.JobId)))
    add(string.format("-- UniverseId   : %d", game.GameId))
    add(string.format("-- Waktu Dump   : %s", os.date("%Y-%m-%d %X")))
    add("-- ==============================================================================")
    add("")
    add("-- [1] BASIC SERVICES & PLAYER REFERENCES")
    add('local Players = game:GetService("Players")')
    add('local Workspace = game:GetService("Workspace")')
    add('local ReplicatedStorage = game:GetService("ReplicatedStorage")')
    add('local TweenService = game:GetService("TweenService")')
    add('local TeleportService = game:GetService("TeleportService")')
    add("")
    add("local player = Players.LocalPlayer")
    add("local character = player.Character or player.CharacterAdded:Wait()")
    add('local hrp = character:WaitForChild("HumanoidRootPart")')
    add('local humanoid = character:WaitForChild("Humanoid")')
    add("")

    -- [2] REMOTES MAP
    add("-- [2] GAME REMOTES (RemoteEvent & RemoteFunction)")
    add("local Remotes = {")
    local remotesFound = {}
    local function scanRemotes(parent)
        pcall(function()
            for _, desc in ipairs(parent:GetDescendants()) do
                if desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") then
                    local cleanName = desc.Name:gsub("[^%w_]", "_")
                    table.insert(remotesFound, {
                        Name = desc.Name,
                        Ident = cleanName,
                        Class = desc.ClassName,
                        Path = getObjectPath(desc)
                    })
                end
            end
        end)
    end
    scanRemotes(ReplicatedStorage)
    scanRemotes(Workspace)

    for _, r in ipairs(remotesFound) do
        add(string.format("    [%q] = %s, -- [[%s]]", r.Name, r.Path, r.Class))
    end
    add("}")
    add("")

    -- Helper pemanggilan remote
    add("-- Helper Fungsi Memanggil Remote Secara Aman")
    add("local function callRemote(remoteName, ...)")
    add("    local remote = Remotes[remoteName]")
    add("    if remote then")
    add('        if remote:IsA("RemoteEvent") then')
    add("            remote:FireServer(...)")
    add('        elseif remote:IsA("RemoteFunction") then')
    add("            return remote:InvokeServer(...)")
    add("        end")
    add("    else")
    add('        warn("[SysHub]: Remote tidak ditemukan: " .. tostring(remoteName))')
    add("    end")
    add("end")
    add("")

    -- [3] PARAMETER TERAKHIR YANG TERTANGKAP OLEH SNIFFER
    add("-- [3] PARAMETER PANGGILAN REMOTE TERTANGKAP (LIVE SNIFFER)")
    if #capturedRemotes > 0 then
        add("local CapturedRemoteCalls = {")
        for i = 1, math.min(20, #capturedRemotes) do
            local cr = capturedRemotes[i]
            add(string.format("    -- [%s] %s (%s)", cr.Time, cr.Name, cr.Method))
            add(string.format("    [%d] = function()", i))
            add(string.format("        %s", cr.CallCode))
            add("    end,")
        end
        add("}")
    else
        add("-- (Belum ada panggilan remote yang tertangkap saat tombol ditekan. Mainkan game/klik aksi untuk menangkap parameter.)")
        add("local CapturedRemoteCalls = {}")
    end
    add("")

    -- [4] PLAYER STATS, LEADERSTATS & ATRIBUT
    add("-- [4] PLAYER DATA, ATRIBUT & STATS")
    local pAttrs = localPlayer:GetAttributes()
    local cAttrs = char and char:GetAttributes() or {}

    add(string.format("local PlayerAttributes = %s", serializeValue(pAttrs, 0)))
    add(string.format("local CharacterAttributes = %s", serializeValue(cAttrs, 0)))

    -- Leaderstats
    local ls = localPlayer:FindFirstChild("leaderstats")
    local lsTable = {}
    if ls then
        for _, s in ipairs(ls:GetChildren()) do
            if s:IsA("ValueBase") then
                lsTable[s.Name] = s.Value
            end
        end
    end
    add(string.format("local Leaderstats = %s", serializeValue(lsTable, 0)))

    -- Folder Data / Stats lain di Player
    local otherValues = {}
    for _, child in ipairs(localPlayer:GetChildren()) do
        if child.Name ~= "leaderstats" and (child:IsA("Folder") or child:IsA("Configuration")) then
            local fData = {}
            for _, v in ipairs(child:GetChildren()) do
                if v:IsA("ValueBase") then
                    fData[v.Name] = v.Value
                end
            end
            if next(fData) ~= nil then otherValues[child.Name] = fData end
        end
    end
    if next(otherValues) ~= nil then
        add(string.format("local OtherPlayerData = %s", serializeValue(otherValues, 0)))
    end
    add("")

    -- [5] WORKSPACE POINTS OF INTEREST (KOORDINAT & JARAK TERDEKAT)
    add("-- [5] KOORDINAT & LOKASI PENTING (POINTS OF INTEREST)")
    add("local Locations = {")
    add(string.format('    ["PlayerSpawnCurrent"] = CFrame.new(%.3f, %.3f, %.3f),', myCF.X, myCF.Y, myCF.Z))

    local keywords = {"spawn", "shop", "store", "merchant", "buy", "sell", "chest", "crate", "box", "egg", "pet", "portal", "door", "teleport", "altar", "npc", "quest", "boss", "mob", "plot", "base", "coop"}
    local scannedPOIs = {}

    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if (obj:IsA("Model") or obj:IsA("BasePart")) and not obj:IsDescendantOf(char) then
                local oName = obj.Name:lower()
                local matched = false
                for _, kw in ipairs(keywords) do
                    if oName:find(kw) then
                        matched = true
                        break
                    end
                end

                if matched then
                    local pos, cf = getInstancePosition(obj)
                    if pos then
                        local dist = (Vector3.new(pos.X, pos.Y, pos.Z) - myPos).Magnitude
                        -- Ambil atribut jika ada
                        local attrs = obj:GetAttributes()
                        local hasA = false
                        for _ in pairs(attrs) do
                            hasA = true
                            break
                        end

                        table.insert(scannedPOIs, {
                            Name = obj.Name,
                            Class = obj.ClassName,
                            Distance = dist,
                            Position = pos,
                            CFrame = cf or CFrame.new(pos),
                            Path = getObjectPath(obj),
                            Attributes = hasA and attrs or nil
                        })
                    end
                end
            end
        end
    end)

    table.sort(scannedPOIs, function(a, b) return a.Distance < b.Distance end)

    -- Batasi maksimal 60 POI terdekat agar rapi & relevan
    local maxPoi = math.min(60, #scannedPOIs)
    for idx = 1, maxPoi do
        local poi = scannedPOIs[idx]
        local key = string.format("%s_%d", poi.Name:gsub("[^%w_]", "_"), idx)
        add(string.format("    [%q] = {", key))
        add(string.format("        Name = %q,", poi.Name))
        add(string.format("        Distance = %.2f, -- studs", poi.Distance))
        add(string.format("        Position = Vector3.new(%.3f, %.3f, %.3f),", poi.Position.X, poi.Position.Y, poi.Position.Z))
        add(string.format("        CFrame = CFrame.new(%.3f, %.3f, %.3f),", poi.CFrame.X, poi.CFrame.Y, poi.CFrame.Z))
        add(string.format("        Path = %s,", poi.Path))
        if poi.Attributes then
            add(string.format("        Attributes = %s,", serializeValue(poi.Attributes, 0)))
        end
        add("    },")
    end
    add("}")
    add("")

    -- [6] PROXIMITY PROMPT / CLICK DETECTOR (INTERAKSI OBJEK)
    add("-- [6] INTERAKTIF: PROXIMITY PROMPTS & CLICK DETECTORS")
    local promptsFound = {}
    pcall(function()
        for _, desc in ipairs(Workspace:GetDescendants()) do
            if desc:IsA("ProximityPrompt") or desc:IsA("ClickDetector") then
                local parentPart = desc.Parent
                local pPos = parentPart and (parentPart:IsA("BasePart") and parentPart.Position or (parentPart:IsA("Model") and parentPart:GetPivot().Position))
                local dist = pPos and (pPos - myPos).Magnitude or 99999
                table.insert(promptsFound, {
                    Name = desc.Name,
                    Class = desc.ClassName,
                    ActionText = desc:IsA("ProximityPrompt") and desc.ActionText or "Click",
                    ObjectText = desc:IsA("ProximityPrompt") and desc.ObjectText or "",
                    Distance = dist,
                    Path = getObjectPath(desc)
                })
            end
        end
    end)
    table.sort(promptsFound, function(a, b) return a.Distance < b.Distance end)

    add("local InteractivePrompts = {")
    for idx = 1, math.min(25, #promptsFound) do
        local p = promptsFound[idx]
        add(string.format("    [%d] = { Name = %q, Action = %q, Object = %q, Distance = %.1f, Path = %s },",
            idx, p.Name, p.ActionText, p.ObjectText, p.Distance, p.Path))
    end
    add("}")
    add("")
    add("-- ==============================================================================")
    add("--                      END OF GENERATED SCRIPT TEMPLATE                          ")
    add("-- ==============================================================================")

    local fullReport = table.concat(lines, "\n")
    lastGeneratedScriptTemplate = fullReport

    -- Cetak ke Output & Salin ke Clipboard
    copyToClipboard(fullReport)

    notify("Sukses!", string.format("Data game lengkap diambil! (%d remote, %d lokasi, %d prompt). Cek Output / Paste!", #remotesFound, #scannedPOIs, #promptsFound))
    return gameName, #remotesFound, #scannedPOIs, #promptsFound, fullReport
