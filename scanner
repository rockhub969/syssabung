local TabSniffer = Window:Tab({ Title = "Parameter Sniffer", Icon = "radio", Locked = false })
local SnifferControlSec = TabSniffer:Section({ Title = "Kontrol Live Parameter Sniffer", Opened = true })
local SnifferLogsSec = TabSniffer:Section({ Title = "Panggilan Remote Terakhir", Opened = true })

local lastSniffPara = SnifferLogsSec:Paragraph({
    Title = "Panggilan Remote Terakhir",
    Desc = "Belum ada pemanggilan remote game. Coba berinteraksi dengan game (beli item, serang, buka peti, dll.)."
})

local recentSniffPara = SnifferLogsSec:Paragraph({
    Title = "5 Pemanggilan Terakhir",
    Desc = "Menunggu pemanggilan remote..."
})

onRemoteCapturedCallback = function(item)
    pcall(function()
        lastSniffPara:SetTitle(string.format("[%s] %s (%s)", item.Time, item.Name, item.Method))
        lastSniffPara:SetDesc(item.CallCode)

        local lines = {}
        for i = 1, math.min(5, #capturedRemotes) do
            local cr = capturedRemotes[i]
            local shortArgs = cr.ParamText:sub(1, 45) .. (#cr.ParamText > 45 and "..." or "")
            table.insert(lines, string.format("#%d [%s] %s:%s(%s)", i, cr.Time, cr.Name, cr.Method, shortArgs))
        end
        recentSniffPara:SetDesc(table.concat(lines, "\n"))
    end)
end

SnifferControlSec:Toggle({
    Title = "Aktifkan Live Parameter Sniffer",
    Desc = "Merekam parameter pemanggilan remote saat Anda bermain game secara real-time.",
    Value = true,
    Callback = function(state)
        isSnifferActive = parseToggle(state)
        notify("Sniffer", isSnifferActive and "Sniffer diaktifkan." or "Sniffer dijeda.")
    end
})

SnifferControlSec:Button({
    Title = "📋 Salin Panggilan Remote Terakhir (Lua Code)",
    Callback = function()
        if lastCapturedCall ~= "" then
            copyToClipboard(lastCapturedCall)
        else
            notify("Info", "Belum ada panggilan remote yang tertangkap.")
        end
    end
})

SnifferControlSec:Button({
    Title = "📋 Export Seluruh Riwayat Parameter Sniffer",
    Callback = function()
        if #capturedRemotes == 0 then
            notify("Info", "Riwayat remote masih kosong.")
            return
        end
        local lines = {"-- ==============================================================================",
                       "-- RIWAYAT PEMANGGILAN PARAMETER REMOTE (LIVE SNIFFER)",
                       "-- =============================================================================="}
        for idx, it in ipairs(capturedRemotes) do
            table.insert(lines, string.format("-- [%s] #%d %s", it.Time, idx, it.Name))
            table.insert(lines, it.CallCode)
        end
        copyToClipboard(table.concat(lines, "\n\n"))
    end
})

SnifferControlSec:Button({
    Title = "🗑️ Bersihkan Log Sniffer",
    Callback = function()
        table.clear(capturedRemotes)
        lastCapturedCall = ""
        lastSniffPara:SetTitle("Panggilan Remote Terakhir")
        lastSniffPara:SetDesc("Log telah dibersihkan.")
        recentSniffPara:SetDesc("Menunggu pemanggilan remote...")
        notify("Sniffer", "Log berhasil dibersihkan.")
    end
})


