-- HELPER: Clipboard Universal & Output Console
-- ------------------------------------------------------------------------------
local function copyToClipboard(text)
    local str = tostring(text)
    -- 1. Salin ke Clipboard OS (bisa langsung Ctrl + V di editor teks)
    local fn = setclipboard or toclipboard or (syn and syn.write_clipboard) or (Clipboard and Clipboard.set)
    if fn then
        pcall(fn, str)
    end

    -- 2. Cetak ke Output Executor & Console Roblox (F9)
    print("\n================ [SCANNER GAME OUTPUT] ================\n" .. str .. "\n=======================================================\n")

    -- 3. Cetak ke Console Eksternal Executor jika ada (rconsoleprint)
    if rconsoleprint then
        pcall(rconsoleprint, "\n[SCANNER GAME OUTPUT]:\n" .. str .. "\n\n")
    end
    notify("Tersalin ke Clipboard!", "Data telah disalin dan dicetak ke output console.")
    return true
end

-- ------------------------------------------------------------------------------
-- HELPER: Format Path Objek ke Format Lua Valid
-- ------------------------------------------------------------------------------
local function getObjectPath(instance)
    if not instance then
        return "nil"
    end
    if instance == game then
        return "game"
    end
    if instance == Workspace then
        return 'game:GetService("Workspace")'
    end

    local parts = {}
    local current = instance

    while current and current ~= game do
        local parent = current.Parent
        local name = current.Name
        local validIdent = name:match("^[%a_][%w_]*$") and not (
            name == "and" or name == "break" or name == "do" or name == "else" or
            name == "elseif" or name == "end" or name == "false" or name == "for" or
            name == "function" or name == "if" or name == "in" or name == "local" or
            name == "nil" or name == "not" or name == "or" or name == "repeat" or
            name == "return" or name == "then" or name == "true" or name == "until" or name == "while"
        )

        if parent == game then
            table.insert(parts, 1, string.format('game:GetService("%s")', name))
            break
        elseif parent == Workspace and #parts == 0 then
            if validIdent then
                table.insert(parts, 1, "workspace." .. name)
            else
                table.insert(parts, 1, string.format('workspace[%q]', name))
            end
            break
        else
            if validIdent then
                table.insert(parts, 1, "." .. name)
            else
                table.insert(parts, 1, string.format('[%q]', name))
            end
        end
        current = parent
    end

    local pathStr = table.concat(parts, "")
    if pathStr:sub(1, 1) == "." then
        pathStr = "game" .. pathStr
    end
    return pathStr
end

-- ------------------------------------------------------------------------------
-- HELPER: Serializer Data & Parameter ke Format Kode Lua
-- ------------------------------------------------------------------------------
local function serializeValue(val, indentLevel, visited)
    indentLevel = indentLevel or 0
    visited = visited or {}
    local indent = string.rep("  ", indentLevel)
    local nextIndent = string.rep("  ", indentLevel + 1)
    local t = typeof(val)

    if t == "nil" then
        return "nil"
    elseif t == "boolean" then
        return val and "true" or "false"
    elseif t == "number" then
        if val ~= val then
            return "0/0 --[[NaN]]"
        end
        if val == math.huge then
            return "math.huge"
        end
        if val == -math.huge then
            return "-math.huge"
        end
        return tostring(val)
    elseif t == "string" then
        return string.format("%q", val)
    elseif t == "Vector3" then
        return string.format("Vector3.new(%.3f, %.3f, %.3f)", val.X, val.Y, val.Z)
    elseif t == "Vector2" then
        return string.format("Vector2.new(%.3f, %.3f)", val.X, val.Y)
    elseif t == "CFrame" then
        local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = val:GetComponents()
        return string.format("CFrame.new(%.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f)",
            x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22)
    elseif t == "Color3" then
        return string.format("Color3.fromRGB(%d, %d, %d)", math.floor(val.R * 255), math.floor(val.G * 255), math.floor(val.B * 255))
    elseif t == "BrickColor" then
        return string.format("BrickColor.new(%q)", val.Name)
    elseif t == "UDim2" then
        return string.format("UDim2.new(%.3f, %d, %.3f, %d)", val.X.Scale, val.X.Offset, val.Y.Scale, val.Y.Offset)
    elseif t == "UDim" then
        return string.format("UDim.new(%.3f, %d)", val.Scale, val.Offset)
    elseif t == "Instance" then
        return getObjectPath(val)
    elseif t == "EnumItem" then
        return tostring(val)
    elseif t == "table" then
        if visited[val] then
            return '"--[[Circular Reference]]"'
        end
        visited[val] = true

        local isArray = true
        local maxIdx = 0
        local count = 0
        for k, _ in pairs(val) do
            count = count + 1
            if type(k) == "number" and k > 0 and math.floor(k) == k then
                if k > maxIdx then maxIdx = k end
            else
                isArray = false
            end
        end
        if count ~= maxIdx then isArray = false end

        if count == 0 then
            return "{}"
        end

        local lines = {"{\n"}
        if isArray then
            for i = 1, maxIdx do
                table.insert(lines, string.format("%s%s,\n", nextIndent, serializeValue(val[i], indentLevel + 1, visited)))
            end
        else
            for k, v in pairs(val) do
                local keyStr
                if type(k) == "string" and k:match("^[%a_][%w_]*$") then
                    keyStr = string.format("[%q]", k)
                else
                    keyStr = string.format("[%s]", serializeValue(k, 0, visited))
                end
                table.insert(lines, string.format("%s%s = %s,\n", nextIndent, keyStr, serializeValue(v, indentLevel + 1, visited)))
            end
        end
        table.insert(lines, indent .. "}")
        return table.concat(lines, "")
    else
        return string.format("%q --[[%s]]", tostring(val), t)
    end
end

