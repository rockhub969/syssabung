local function getLocalPlayerPosition()
    local char = localPlayer.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
    return hrp and hrp.Position or nil
end

local function getInstancePosition(inst)
    if not inst then
        return nil, nil, nil
    end
    if inst:IsA("BasePart") then
        return inst.Position, inst.CFrame, inst.Size
    elseif inst:IsA("Model") then
        local pivot = inst:GetPivot()
        local cf, sz = pcall(function() return inst:GetBoundingBox() end)
        return pivot.Position, pivot, (sz or Vector3.new(4, 4, 4))
    end
    return nil, nil, nil
end

-- ==============================================================================
-- LIVE REMOTE PARAMETER SNIFFER ENGINE
-- ==============================================================================
local isSnifferActive = true
local capturedRemotes = {}
local lastCapturedCall = ""
local onRemoteCapturedCallback = nil

local function recordRemoteCall(remote, method, args)
    if not isSnifferActive then
        return
    end
    local rPath = getObjectPath(remote)
    local sArgs = {}
    for _, a in ipairs(args) do
        table.insert(sArgs, serializeValue(a, 0))
    end
    local paramText = table.concat(sArgs, ", ")
    local fullCall = string.format("%s:%s(%s)", rPath, method, paramText)
    lastCapturedCall = fullCall

    local logItem = {
        Time = os.date("%X"),
        Remote = remote,
        Name = remote.Name,
        Method = method,
        ParamText = paramText,
        CallCode = fullCall,
        Args = args
    }

    table.insert(capturedRemotes, 1, logItem)
    if #capturedRemotes > 100 then table.remove(capturedRemotes) end

    -- Cetak ke Console secara real-time
    print(string.format("[SNIFFER] %s", fullCall))

    if onRemoteCapturedCallback then
        pcall(onRemoteCapturedCallback, logItem)
    end
end

-- Hook metamethod untuk menangkap panggilan remote game
pcall(function()
    local oldNamecall = nil
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if (method == "FireServer" or method == "InvokeServer") and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
            local args = {...}
            task.spawn(function()
                recordRemoteCall(self, method, args)
            end)
        end
        return oldNamecall(self, ...)
    end))
end)

-- Fallback remote listener
task.spawn(function()
    local function hookRemote(obj)
        if obj:IsA("RemoteEvent") then
            obj.OnClientEvent:Connect(function(...)
                recordRemoteCall(obj, "OnClientEvent", {...})
            end)
        end
    end
    for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
        if desc:IsA("RemoteEvent") then pcall(hookRemote, desc) end
    end
    ReplicatedStorage.DescendantAdded:Connect(function(desc)
        if desc:IsA("RemoteEvent") then pcall(hookRemote, desc) end
    end)
end)

